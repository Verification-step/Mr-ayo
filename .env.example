# Copy this file to `.env` and fill in the values locally.
# DO NOT put real keys in GitHub.

# REQUIRED — your OpenRouter key. Used for the brain, perception/STT, and TTS.
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE

# OPTIONAL — reserved for a future direct Google fallback.
GOOGLE_AI_API_KEY=PASTE_GOOGLE_KEY_HERE_IF_NEEDED

# Free OpenRouter models selected for Mr Ayo.
BRAIN_MODEL=google/gemma-4-26b-a4b-it:free
BRAIN_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PERCEPTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
TTS_MODEL=fish-audio/s2.1-pro:free
TTS_VOICE=alloy

MR_AYO_HOST=127.0.0.1
MR_AYO_PORT=8765
