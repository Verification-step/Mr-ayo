# Copy to .env. NEVER commit real API keys.

# REQUIRED: OpenRouter key (brain + STT + TTS routing)
OPENROUTER_API_KEY=PASTE_YOUR_OPENROUTER_KEY_HERE

# OPTIONAL: reserved direct Google fallback
GOOGLE_AI_API_KEY=PASTE_GOOGLE_KEY_HERE_IF_NEEDED

# Brain models. openrouter/free automatically chooses a currently available free model
# with the features requested by the call. A fixed free fallback is also configured.
BRAIN_MODEL=openrouter/free
BRAIN_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
PERCEPTION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# TTS. OpenRouter's current Kokoro endpoint is paid, so leave this configurable.
# For a strictly zero-cost build, set USE_LOCAL_TTS=true and install a local TTS engine.
TTS_MODEL=hexgrad/kokoro-82m
TTS_VOICE=alloy
USE_LOCAL_TTS=true

# Wake phrase
WAKE_PHRASE=mr ayo

MR_AYO_HOST=127.0.0.1
MR_AYO_PORT=8765
